{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ubr/judge.schema.json",
  "title": "Independent judge verdict on the research plan",
  "type": "object",
  "required": ["iteration", "scores", "critical_issues", "sota_assessment"],
  "additionalProperties": false,
  "properties": {
    "iteration": {"type": "integer", "minimum": 1},
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["score", "rationale"],
        "additionalProperties": false,
        "properties": {
          "score": {"type": "number", "minimum": 0, "maximum": 5},
          "rationale": {"type": "string", "minLength": 10},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "critical_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "finding"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^JD-[0-9]{2,4}-[0-9]{2,3}$"},
          "module": {"type": "string", "pattern": "^(M[0-9]{2}|SCOPE|METHODS|SOURCES|OUTLINE|GLOBAL)$"},
          "finding": {"type": "string", "minLength": 10}
        }
      }
    },
    "top_improvements": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
    "sota_assessment": {"type": "string", "minLength": 20}
  }
}
