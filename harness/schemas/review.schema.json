{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ubr/review.schema.json",
  "title": "Specialist review of the research plan",
  "type": "object",
  "required": ["reviewer", "iteration", "summary", "scores", "issues"],
  "additionalProperties": false,
  "properties": {
    "reviewer": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "iteration": {"type": "integer", "minimum": 1},
    "summary": {"type": "string", "minLength": 20},
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/criterionScore"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "missing_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rationale"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 3},
          "rationale": {"type": "string", "minLength": 10},
          "suggested_module": {"type": "string"}
        }
      }
    },
    "suggested_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceRef"}
    }
  },
  "$defs": {
    "criterionScore": {
      "type": "object",
      "required": ["score", "rationale"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 5},
        "rationale": {"type": "string", "minLength": 10}
      }
    },
    "issue": {
      "type": "object",
      "required": ["id", "severity", "module", "finding", "proposal"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2,4}-[0-9]{2,3}$"},
        "severity": {"enum": ["critical", "major", "minor"]},
        "module": {"type": "string", "pattern": "^(M[0-9]{2}|SCOPE|METHODS|SOURCES|OUTLINE|GLOBAL)$"},
        "finding": {"type": "string", "minLength": 10},
        "proposal": {"type": "string", "minLength": 10},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["title"],
      "anyOf": [{"required": ["url"]}, {"required": ["doi"]}],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "authors": {"type": "array", "items": {"type": "string"}},
        "year": {"type": "integer"},
        "url": {"type": "string", "pattern": "^https?://"},
        "doi": {"type": "string", "pattern": "^10\\."}
      }
    }
  }
}
