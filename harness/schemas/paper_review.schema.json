{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ubr/paper_review.schema.json",
  "title": "Adversarial review of the Universal Basic Rent paper monograph",
  "type": "object",
  "required": ["reviewer", "iteration", "summary", "scores", "issues"],
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "pattern": "^adversarial-[a-z0-9-]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/criterionScore"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "unaddressed_counterarguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argument", "threat_level", "suggested_chapter"],
        "additionalProperties": false,
        "properties": {
          "argument": {"type": "string", "minLength": 10},
          "threat_level": {"enum": ["fatal", "severe", "moderate"]},
          "suggested_chapter": {"type": "string"}
        }
      }
    },
    "suggested_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    }
  },
  "$defs": {
    "criterionScore": {
      "type": "object",
      "required": ["score", "rationale"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 5},
        "rationale": {"type": "string", "minLength": 10}
      }
    },
    "issue": {
      "type": "object",
      "required": ["id", "severity", "chapter", "finding", "counterargument_or_flaw", "proposed_amendment"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADV-[A-Z0-9]+-[0-9]{2,4}-[0-9]{2,3}$"
        },
        "severity": {
          "enum": ["critical", "major", "minor"]
        },
        "chapter": {
          "type": "string",
          "pattern": "^(ch0[0-8]|GLOBAL|MONOGRAPH)$"
        },
        "finding": {
          "type": "string",
          "minLength": 10
        },
        "counterargument_or_flaw": {
          "type": "string",
          "minLength": 10
        },
        "proposed_amendment": {
          "type": "string",
          "minLength": 10
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["title"],
      "anyOf": [{"required": ["url"]}, {"required": ["doi"]}],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "authors": {"type": "array", "items": {"type": "string"}},
        "year": {"type": "integer"},
        "url": {"type": "string", "pattern": "^https?://"},
        "doi": {"type": "string", "pattern": "^10\\."}
      }
    }
  }
}
